{
  "ai": {
    "provider": "openai",
    "model": "deepseek/deepseek-v4.1-flash-1017",
    "base_url": "https://api.tokenplus.cn/v1",
    "api_key_env": "TOKENPLUS_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "crypto-btc",
    "profile_settings": {
      "crypto-btc": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "tech-news": {
        "threshold": 7.5,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "bitcoin",
        "repo": "bitcoin",
        "enabled": true,
        "profile": "crypto-btc"
      },
      {
        "type": "repo_releases",
        "owner": "bitcoin",
        "repo": "bips",
        "enabled": true,
        "profile": "crypto-btc"
      }
    ],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "CoinDesk",
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "enabled": true,
        "category": "btc-news",
        "profile": "crypto-btc"
      },
      {
        "name": "Cointelegraph",
        "url": "https://cointelegraph.com/rss",
        "enabled": true,
        "category": "btc-news",
        "profile": "crypto-btc"
      },
      {
        "name": "The Block",
        "url": "https://www.theblock.co/rss.xml",
        "enabled": true,
        "category": "btc-news",
        "profile": "crypto-btc",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Decrypt",
        "url": "https://decrypt.co/feed",
        "enabled": true,
        "category": "btc-news",
        "profile": "crypto-btc"
      },
      {
        "name": "Bitcoin Optech",
        "url": "https://bitcoinops.org/feed.xml",
        "enabled": true,
        "category": "btc-tech",
        "profile": "crypto-btc",
        "content_extractor": "trafilatura"
      },
      {
        "name": "The Bitcoin Layer",
        "url": "https://thebitcoinlayer.substack.com/feed",
        "enabled": true,
        "category": "btc-macro",
        "profile": "crypto-btc",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Bitfinex Blog",
        "url": "https://blog.bitfinex.com/feed/",
        "enabled": true,
        "category": "btc-markets",
        "profile": "crypto-btc"
      },
      {
        "name": "PANews",
        "url": "https://rss.panewslab.com/zh/gtimg/rss",
        "enabled": true,
        "category": "btc-cn",
        "profile": "crypto-btc"
      },
      {
        "name": "链捕手 ChainCatcher",
        "url": "https://www.chaincatcher.com/rss/clist",
        "enabled": true,
        "category": "btc-cn",
        "profile": "crypto-btc"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "Bitcoin",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 80,
          "profile": "crypto-btc"
        },
        {
          "subreddit": "BitcoinMarkets",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "profile": "crypto-btc"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "btcbiquan",
          "enabled": true,
          "fetch_limit": 25,
          "profile": "crypto-btc"
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 12
  },
  "digest": {
    "max_items": 15,
    "profile_order": [
      "crypto-btc",
      "tech-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "feishu",
    "layout": "collapsible",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "msg_type": "interactive",
      "card": {
        "schema": "2.0",
        "config": {
          "wide_screen_mode": true
        },
        "header": {
          "title": {
            "tag": "plain_text",
            "content": "#{message_title}"
          },
          "template": "blue"
        },
        "body": {
          "elements": [
            {
              "tag": "markdown",
              "content": "#{summary}"
            }
          ]
        }
      }
    },
    "headers": "",
    "title_prefix": "BTC"
  }
}
